{
  "$schema": "https://unpkg.com/knip@5/schema.json",

  // ── O que o Knip faz aqui, e o que ele NÃO faz ─────────────────────────────
  //
  // Ele acha o que ninguém usa: arquivo que nenhum outro importa, export que
  // ninguém chama, dependência declarada que nenhum código instala.
  //
  // **Entra como RELATÓRIO, não como portão.** A primeira execução sem
  // configuração devolveu 98 arquivos e 76 devDependencies — quase tudo ruído
  // de biblioteca copiada. Fazer o CI falhar com esse número seria criar um
  // portão que ninguém consegue atravessar, e portão assim se contorna, não se
  // respeita.
  //
  // O objetivo desta configuração é que o número que sobra SIGNIFIQUE alguma
  // coisa. Zerá-lo é trabalho de outra história.

  "workspaces": {
    "artifacts/api-server": {
      // ── Dois arquivos que ninguem importa e que NAO sao codigo morto ─────
      //
      // `src/migrar.ts` vira `dist/migrar.mjs` e e o COMANDO do conteiner de
      // migracao que a esteira dispara dentro da AWS (#201).
      //
      // `src/restaurar-backup.ts` e a metade do backup que abre o arquivo
      // cifrado (#199) — o runbook restaurar-backup.md manda rodar ele.
      //
      // Os dois sao alcancados por linha de comando, nunca por import. Sem
      // esta linha o Knip os reporta como arquivos sem uso, e um dia alguem
      // apaga acreditando no relatorio — inclusive o unico jeito de ler uma
      // copia de seguranca.
      "entry": [
        "src/index.ts",
        "src/migrar.ts",
        "src/restaurar-backup.ts",
        "src/seed.ts",
        "src/tests/*.test.ts",
        "scripts/*.mjs",
        "build.mjs"
      ],
      "project": ["src/**/*.ts"]
    },
    "artifacts/zelo": {
      // Os componentes do shadcn/ui entram como PONTO DE ENTRADA, não como
      // ignorados — e a diferença importa.
      //
      // Ignorar tira o arquivo do grafo, e aí os `import` que ele faz somem
      // junto: o Knip passou a acusar 32 pacotes @radix-ui como não usados,
      // quando eles são usados exatamente ali. Falso positivo criado pela
      // própria configuração.
      //
      // Como entrada, os imports deles contam e os exports não são cobrados —
      // que é o tratamento certo para biblioteca copiada: um componente ainda
      // não usado não é código morto, é biblioteca esperando uso.
      "entry": ["src/main.tsx", "src/sw.ts", "vite.config.ts", "src/components/ui/**"],
      "project": ["src/**/*.{ts,tsx}"]
    },
    "lib/db": {
      "entry": ["src/index.ts", "src/apply-raw-sql.ts", "scripts/*.mjs"],
      "project": ["src/**/*.ts"]
    },
    "lib/scheduling": { "entry": ["src/index.ts"], "project": ["src/**/*.ts"] },
    "lib/api-zod": { "entry": ["src/index.ts"], "project": ["src/**/*.ts"] }
  },

  // O mockup-sandbox é área de rascunho de interface, não código de produção.
  // Cobrar código morto de um sandbox é cobrar a coisa errada.
  "ignoreWorkspaces": ["artifacts/mockup-sandbox", "lib/api-client-react", "scripts"],

  "ignoreDependencies": [
    // Usados por configuração ou pela linha de comando, nunca por `import` —
    // o Knip não tem como enxergar isso sozinho.
    "tsx",
    "esbuild",
    "esbuild-plugin-pino",
    "pino-pretty",
    "thread-stream",
    "@biomejs/biome",
    "knip",
    // Usado pelo playwright.config.ts e pelos specs em e2e/, que nao fazem
    // parte de nenhum workspace do pnpm.
    "@playwright/test",

    // ── Falsos positivos: o Knip nao le CSS ────────────────────────────────
    //
    // Estes tres sao usados em artifacts/zelo/src/index.css, por diretiva do
    // Tailwind — `@import` e `@plugin`. O Knip analisa o grafo de modulos
    // JavaScript e nao enxerga isso, entao acusa como nao usados.
    //
    // **Remover qualquer um quebraria todas as telas do app.** Foi o cuidado
    // numero um da Issue #10, e a suspeita se confirmou.
    "tailwindcss",
    "@tailwindcss/typography",
    "tw-animate-css"
  ],

  // Um export sem uso hoje pode ser API pública deliberada. O Knip lista; quem
  // decide apagar é quem conhece a intenção.
  "includeEntryExports": false
}
