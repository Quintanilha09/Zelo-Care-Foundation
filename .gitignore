# See https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files for more about ignoring files.

# compiled output
dist
tmp
out-tsc
*.tsbuildinfo
.expo
.expo-shared

# dependencies
node_modules

# IDEs and editors
/.idea
.project
.classpath
.c9/
*.launch
.settings/
*.sublime-workspace

# IDE - VSCode
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# misc
/.sass-cache
/connect.lock
/coverage
/libpeerconnection.log
npm-debug.log
yarn-error.log
testem.log
/typings

# System Files
.DS_Store
Thumbs.db

.cursor/rules/nx-rules.mdc
.github/instructions/nx.instructions.md

# Replit
.cache/
.local/

# Local secrets -- nunca versionar
.env
.env.*
!.env.example

# GSD Core -- ferramenta, nao codigo do projeto.
# 716 arquivos / 13MB instalados por `npx @opengsd/gsd-core@latest --claude --local`.
# O proprio projeto avisa: nao copiar arquivos de agents/ ou commands/ direto --
# o instalador e necessario para compatibilidade entre runtimes. Ele tambem se
# auto-atualiza, entao versionar geraria ruido de merge a cada update.
# settings.local.json e, por convencao, configuracao de maquina.
.claude/

# Skills instaladas por `npx skills add` — ferramenta de agente, nao codigo do
# projeto, mesma regra do .claude/. O que NAO fica de fora e o
# skills-lock.json: ele registra QUAL skill e em que versao, e isso e decisao
# do projeto, nao configuracao de maquina.
.agents/skills/

# Saida do Playwright — rastro, video e captura de falha. Regerado a cada
# execucao, e no CI vai como artefato do job.
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/
